{
  "firewallEnabled": true,
  "rules": [
    {
      "name": "Search API rate limit",
      "description": "Allow up to 60 search API requests per minute per IP; reject excess traffic at the edge.",
      "active": true,
      "conditionGroup": [
        {
          "conditions": [{ "type": "path", "op": "pre", "value": "/api/" }]
        }
      ],
      "action": {
        "mitigate": {
          "action": "rate_limit",
          "rateLimit": {
            "algo": "fixed_window",
            "window": 60,
            "limit": 60,
            "keys": ["ip"],
            "action": "rate_limit"
          }
        }
      }
    }
  ]
}
